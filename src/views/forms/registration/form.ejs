<%- include('../../partials/header') %>
<main>
    <h1><%= title %></h1>
    <p>
        Register for a new account by providing your information below. All fields are required and passwords must meet security requirements.
    </p>
    <form method="POST" action="/register" class="registration-form">
        <!-- Name field -->
        <div class="form-group">
            <label for="name">Full Name</label>
            <input type="text" id="name" name="name"
                placeholder="Enter your full name"
                minlength="2" maxlength="100" required autocomplete="name">
        </div>

        <!-- Email field -->
        <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email"
                placeholder="you@example.com"
                maxlength="255" required autocomplete="email">
        </div>

        <!-- Email confirmation field -->
        <div class="form-group">
            <label for="emailConfirm">Confirm Email Address</label>
            <input type="email" id="emailConfirm" name="emailConfirm"
                placeholder="Re-enter your email"
                maxlength="255" required autocomplete="email">
        </div>

        <!-- Password field -->
        <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password"
                minlength="8" maxlength="128" required
                pattern="(?=.*[0-9])(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9]).*"
                autocomplete="new-password">
            <div class="help-text">8–128 characters, with uppercase, lowercase, a number, and a special character</div>
        </div>

        <!-- Password confirmation field -->
        <div class="form-group">
            <label for="passwordConfirm">Confirm Password</label>
            <input type="password" id="passwordConfirm" name="passwordConfirm"
                minlength="8" maxlength="128" required
                autocomplete="new-password">
        </div>

        <!-- Submit button -->
        <button type="submit">Create Account</button>
    </form>
</main>
<%- include('../../partials/footer') %>